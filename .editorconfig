# Aroel — strict .NET + Dart editor settings
# Root-level rules apply to the whole repo; sections below refine per language.
root = true

# ============================================
# All files
# ============================================
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ============================================
# XML / config files
# ============================================
[*.{csproj,slnx,props,targets,config,xaml,xml}]
indent_size = 2

# ============================================
# JSON
# ============================================
[*.json]
indent_size = 2

# ============================================
# C# — strict
# ============================================
[*.cs]
indent_size = 4

# --- Analyzers: on, latest, strict ---
dotnet_analyzer_diagnostic.severity = error
dotnet_diagnostic.CA.skip_analyzer_analysis = false
dotnet_diagnostic.CA1848.severity = none        # LoggerMessage perf rule is noisy; opt in later

# --- Nullability: treat everything as non-null until proven ---
dotnet_style_readonly_field = true
csharp_style_var_when_type_is_apparent = false
csharp_style_var_elsewhere = false
csharp_style_var_for_built_in_types = false

csharp_style_namespace_declarations = file_scoped:warning
csharp_style_prefer_primary_constructors = false
csharp_prefer_system_using_directives = true
csharp_prefer_braces = true:warning
csharp_style_prefer_pattern_matching = true
csharp_style_prefer_switch_expressions = true
csharp_style_prefer_null_check_over_type_check = true
csharp_style_prefer_method_group_conversion = true
csharp_style_unused_value_assignment_preference = discard_variable:warning
csharp_style_unused_value_expression_statement_preference = discard_variable:none

# --- Nullable-reference diagnostics escalated to errors ---
dotnet_diagnostic.CS8600.severity = error   # null assigned to non-nullable
dotnet_diagnostic.CS8601.severity = error   # null argument
dotnet_diagnostic.CS8602.severity = error   # dereference of possibly-null
dotnet_diagnostic.CS8603.severity = error   # null return
dotnet_diagnostic.CS8604.severity = error   # null possible argument
dotnet_diagnostic.CS8613.severity = error   # nullability mismatch in constraints
dotnet_diagnostic.CS8618.severity = error   # non-nullable field uninitialized
dotnet_diagnostic.CS8619.severity = error   # nullability mismatch in assignment
dotnet_diagnostic.CS8620.severity = error   # nullability mismatch in argument
dotnet_diagnostic.CS8622.severity = error   # nullability mismatch in type parameter
dotnet_diagnostic.CS8624.severity = error   # nullability mismatch in output
dotnet_diagnostic.CS8625.severity = error   # null literal to non-nullable ref
dotnet_diagnostic.CS8629.severity = error   # nullable value may be null
dotnet_diagnostic.CS8632.severity = error  # nullable annotation misuse outside #nullable
dotnet_diagnostic.CS8714.severity = error  # nullability not satisfied by type param

# --- Null-safety CA rules ---
dotnet_diagnostic.CA1062.severity = error    # validate args of public APIs
dotnet_diagnostic.CA1515.severity = error    # make types internal
dotnet_diagnostic.CA2007.severity = none     # ConfigureAwait: not needed for ASP.NET/Blazor
dotnet_diagnostic.CA2254.severity = warning  # no interpolation into log templates

# --- Explicit types & modularity ---
dotnet_diagnostic.IDE0008.severity = error   # prefer explicit types over var
dotnet_diagnostic.IDE0017.severity = error   # object initializers
dotnet_diagnostic.IDE0055.severity = error   # formatting fixes apply

# --- Naming: interfaces, private fields, consts ---
dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_rule.private_fields_camel_underscore.severity = error
dotnet_naming_rule.private_fields_camel_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_camel_underscore.style = camel_underscore
dotnet_naming_rule.constants_pascal_case.severity = error
dotnet_naming_rule.constants_pascal_case.symbols = constants
dotnet_naming_rule.constants_pascal_case.style = pascal_case

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case
dotnet_naming_style.camel_underscore.required_prefix = _
dotnet_naming_style.camel_underscore.capitalization = camel_case
dotnet_naming_style.pascal_case.capitalization = pascal_case

# --- Code layout ---
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_preserve_single_line_statements = false
csharp_using_directive_placement = outside_namespace:warning

# ============================================
# Flutter / Dart
# ============================================
[*.dart]
# Analyzer severities come from analysis_options.yaml; keep formatting here.
curly_brace_placement = always
dot.spacing = true
indent_size = 2

# ============================================
# Generated code — relax everything
# ============================================
[{obj/**,bin/**,**/*.g.dart,**/*.freezed.dart,**/*.mapper.dart,**/Migrations/**}]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
