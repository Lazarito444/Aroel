{
  "ConnectionStrings": {
    "Aroel": "Host=localhost;Port=5432;Database=aroel;Username=postgres"
  },
  "Jwt": {
    // Empty in development: a throwaway key is generated per run and sessions die with it.
    // Set Jwt__IssuingKey in the environment for any shared host; never commit one.
    "IssuingKey": ""
  },
  "Email": {
    // Where the confirmation link points. The development host prints it to the log instead.
    "ConfirmationBaseUrl": "https://aroel.invalid/confirm-email"
  },
  "Apple": {
    // The Services ID (client id) of the Apple sign-in configuration. Empty disables Apple sign-in.
    "ClientId": ""
  },
  "Google": {
    // The client id of the Google sign-in configuration. Empty disables Google sign-in.
    "ClientId": ""
  },
  "RateLimits": {
    "AuthPerMinute": 5,
    "SyncPerMinute": 60,
    "InsightsPerMinute": 30
  },
  "Storage": {
    // "npgsql" in every real host; "inmemory" is what the integration tests use.
    "Provider": "npgsql"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
